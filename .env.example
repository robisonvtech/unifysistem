# Public URL copied from the Cakto product checkout. It is safe to expose in the browser.
VITE_CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/SEU-CHECKOUT

# Server-only settings. Configure these in Lovable Cloud / your deployment environment.
CAKTO_WEBHOOK_SECRET=28f2c3b1-8c11-4c95-82d9-2c07b170263b
CAKTO_PRODUCT_ID=ID_DO_SEU_PRODUTO

# ── AI Gateway (server-side only) ────────────────────────────────
AI_PROVIDER=openai
AI_FALLBACK_PROVIDERS=openrouter,gemini,claude,lovable
MODEL_NAME=gpt-4o
TEMPERATURE=0.4
MAX_TOKENS=4096
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
AI_CONTEXT_MESSAGES=24
AI_RATE_LIMIT_PER_MIN=20
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
